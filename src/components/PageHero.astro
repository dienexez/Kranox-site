---
import SectionLabel from "./SectionLabel.astro";

interface Props {
  label: string;
  title: string;
  lead: string;
  /** A small line below the lead, such as the date of the text. */
  note?: string;
}

const { label, title, lead, note } = Astro.props;
---

<!--
  The top of a page of its own, like the title of the sunrise on the home page: the label between stars, the title in
  capitals, a lead in plain words, and a small note, such as the date of the text. The docs and the articles use it;
  a page can add a part of its own below the note.
-->
<header class="page-hero">
  <SectionLabel text={label} />
  <h1 class="page-hero__title type-h3 text-balance" data-reveal="words">
    {title}
  </h1>
  <p class="page-hero__lead text-plain text-soft">{lead}</p>
  {note !== undefined && <p class="type-p6 text-soft">{note}</p>}
  <slot />
</header>

<style>
  .page-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-24);
    text-align: center;
  }

  .page-hero__title {
    max-width: 14em;
  }

  .page-hero__lead {
    max-width: var(--measure-read);
    font-size: var(--type-read-lead);
    font-weight: var(--font-weight-read);
    line-height: var(--leading-read);
  }
</style>
