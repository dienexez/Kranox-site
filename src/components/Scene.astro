---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import palette from "@brand/palette.json";
import { LAYER_DEFAULTS, PICTURE_SAMPLES_PER_CELL } from "../scripts/scene/defaults.ts";
import type { Layer, Scene } from "../scripts/scene/types.ts";

interface Props {
  scene: Scene<ImageMetadata>;
  class?: string;
}

/** Gives a layer the address of its picture, at the small size that its grid needs. */
async function resolveLayer(layer: Layer<ImageMetadata>): Promise<Layer<string>> {
  const { source } = layer;
  if (source.kind !== "picture") return { ...layer, source };
  const columns = layer.columns ?? LAYER_DEFAULTS.columns;
  const picture = await getImage({ src: source.picture, width: columns * PICTURE_SAMPLES_PER_CELL, format: "webp" });
  return { ...layer, source: { ...source, picture: picture.src } };
}

const { scene, class: className } = Astro.props;
const pageScene: Scene<string> = { ...scene, layers: await Promise.all(scene.layers.map(resolveLayer)) };
---

<!--
  The script draws the scene on the canvas as vertical bars. A scene is decoration, so assistive technology
  skips it. Without the script, or without WebGL, the canvas stays empty and the page keeps its grounds.
-->
<canvas
  class:list={["scene", className]}
  aria-hidden="true"
  data-scene={JSON.stringify(pageScene)}
  data-scene-dark={palette.colors.coal}
  data-scene-light={palette.colors.cream}
></canvas>

<script>
  import { initScenes } from "../scripts/scene/index.ts";

  initScenes();
</script>

<style>
  /* A parent gives the canvas its place and its size. */
  .scene {
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
