---
import type { SOCIAL_LINKS } from "../data/site.ts";

interface Props {
  name: keyof typeof SOCIAL_LINKS;
}

// The marks of the services, as their owners publish them: the logo of X from its brand kit, and the mark of
// GitHub from its Octicons (MIT). Each one fills a square and takes the color of the text.
const MARKS = {
  x: {
    viewBox: "0 0 1200 1227",
    path: "M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z",
  },
  github: {
    viewBox: "0 0 16 16",
    path: "M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z",
  },
} as const;

const { name } = Astro.props;
const mark = MARKS[name];
---

<!-- The link around the mark carries its name for assistive technology, so the mark itself is hidden. -->
<svg class="social-icon" viewBox={mark.viewBox} fill="currentColor" aria-hidden="true" focusable="false">
  <path d={mark.path}></path>
</svg>

<style>
  .social-icon {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
