---
import { Image } from "astro:assets";
import { ARTICLE_COVERS } from "../../assets/images.ts";
import { type Article, ARTICLES, articleDate, readingMinutes } from "../../data/articles.ts";
import { articleHref } from "../../data/site.ts";
import DraftPill from "./DraftPill.astro";

interface Props {
  article: Article;
}

// A cover shows wider than its place, so that it stays sharp on a dense screen. Three cards share a wide row, two a
// middle one, and one card fills a narrow row.
const COVER_WIDTHS_PX = [480, 800, 1200];
const COVER_SIZES = "(min-width: 62rem) 28rem, (min-width: 40rem) 46vw, 92vw";

const { article } = Astro.props;
const { data } = article;
const meta = `${articleDate(article)} · ${ARTICLES.minutesRead(readingMinutes(article))}`;
---

<!--
  One article in the grid: a card of white paper, like the panels of the drawings on the home page, with the cover at
  its top, then the date and the time to read as a small label, the title in the serif, and the lead in plain words.
  The whole card is the link. The title names the link, so the cover is decoration here; the article page gives it
  its words.
-->
<article class="article-card" data-reveal="lift">
  <a class="article-card__link" href={articleHref(article.id)}>
    <div class="article-card__cover">
      <Image
        class="article-card__image"
        src={ARTICLE_COVERS[data.cover]}
        alt=""
        widths={COVER_WIDTHS_PX}
        sizes={COVER_SIZES}
      />
    </div>
    <div class="article-card__text text-plain">
      <p class="article-card__meta">{meta}</p>
      <h2 class="article-card__title type-h5 text-balance">{data.title}</h2>
      <p class="article-card__lead">{data.lead}</p>
      {data.draft && <DraftPill />}
    </div>
  </a>
</article>

<style>
  .article-card {
    height: 100%;
  }

  .article-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-paper);
    background: var(--color-white);
    box-shadow: var(--shadow-paper);
  }

  /* The cover keeps the shape of the images of the posts on X. */
  .article-card__cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-dark);
  }

  .article-card__cover :global(.article-card__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long) var(--ease-out);
  }

  .article-card__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem 1.75rem 1.75rem;
  }

  /* A small label in capitals, like the columns of the footer. It keeps its look in plain text. */
  .article-card__meta {
    color: var(--ink-soft);
    font-size: var(--type-p6);
    font-stretch: var(--font-stretch-text);
    font-weight: var(--font-weight-text);
    line-height: var(--leading-p6);
    letter-spacing: var(--tracking-text);
    text-transform: uppercase;
  }

  .article-card__title {
    font-size: clamp(1.5rem, 2.1vw, 2rem);
    line-height: 1.1;
  }

  .article-card__lead {
    color: var(--ink-read);
    font-size: 1rem;
    font-weight: var(--font-weight-read);
    line-height: var(--leading-read);
  }

  /* Under the pointer the cover moves a little closer. */
  @media (hover: hover) {
    .article-card__link:hover :global(.article-card__image) {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card__cover :global(.article-card__image) {
      transition: none;
    }
  }
</style>
