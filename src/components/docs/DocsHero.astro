---
import { DOCS } from "../../data/docs.ts";
import SectionLabel from "../SectionLabel.astro";

const { hero } = DOCS;
---

<!--
  The top of the docs, like the title of the sunrise on the home page: the label between stars, the title in
  capitals, a lead in plain words, and the date of the text.
-->
<header class="docs-hero">
  <SectionLabel text={hero.label} />
  <h1 class="docs-hero__title type-h3 text-balance" data-reveal="words">
    {hero.title}
  </h1>
  <p class="docs-hero__lead text-plain text-soft">{hero.lead}</p>
  <p class="docs-hero__updated type-p6 text-soft">
    {hero.updatedLabel} {hero.updated}
  </p>
</header>

<style>
  .docs-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-24);
    text-align: center;
  }

  .docs-hero__title {
    max-width: 14em;
  }

  .docs-hero__lead {
    max-width: var(--measure-read);
    font-size: var(--type-read-lead);
    font-weight: var(--font-weight-read);
    line-height: var(--leading-read);
  }
</style>
