---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { ARTICLE_COVERS } from "../../assets/images.ts";
import ArticleBody from "../../components/articles/ArticleBody.astro";
import ArticleSide from "../../components/articles/ArticleSide.astro";
import DraftPill from "../../components/articles/DraftPill.astro";
import Footer from "../../components/Footer.astro";
import Menu from "../../components/Menu.astro";
import PageHero from "../../components/PageHero.astro";
import Scene from "../../components/Scene.astro";
import {
  type Article,
  ARTICLES,
  articleDate,
  articlePageTitle,
  listArticles,
  readingMinutes,
} from "../../data/articles.ts";
import { SCENES } from "../../data/scenes.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";

// One page for each article that the build shows: in the build of the deploy, the articles that are not drafts.
export const getStaticPaths = (async () => {
  const articles = await listArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}) satisfies GetStaticPaths;

interface Props {
  article: Article;
}

// The headings of the second level are the parts of an article, which the list at the side links to.
const PART_DEPTH = 2;

// The cover shows wider than its place, so that it stays sharp on a dense screen. It takes the columns of the text.
const COVER_WIDTHS_PX = [800, 1200, 1600];
const COVER_SIZES = "(min-width: 62rem) 56rem, 92vw";

const { article } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
const parts = headings.filter((heading) => heading.depth === PART_DEPTH);
const cover = ARTICLE_COVERS[data.cover];
const note = `${articleDate(article)} · ${ARTICLES.minutesRead(readingMinutes(article))}`;
---

<!--
  One article, in the layout of the docs: the top like the title of the sunrise, then the list of the parts at the
  side and the text beside it, with the cover above the text. The band of bars and the footer of the home page close
  the page.
-->
<BaseLayout
  title={articlePageTitle(article)}
  description={data.lead}
  socialImage={cover}
  socialImageAlt={data.coverAlt}
  kind="article"
>
  <Menu />
  <main class="article theme-light ground">
    <div class="article__top container">
      <div class="inset-wide">
        <PageHero label={ARTICLES.hero.label} title={data.title} lead={data.lead} note={note}>
          {data.draft && <DraftPill />}
        </PageHero>
      </div>
    </div>
    <div class="article__body container">
      <div class="grid inset-wide">
        <aside class="article__side">
          <ArticleSide parts={parts} />
        </aside>
        <div class="article__main">
          <figure class="article__cover" data-reveal="lift">
            <Image
              class="article__cover-image"
              src={cover}
              alt={data.coverAlt}
              widths={COVER_WIDTHS_PX}
              sizes={COVER_SIZES}
            />
          </figure>
          <ArticleBody>
            <Content />
          </ArticleBody>
        </div>
      </div>
    </div>
    <!-- A band of bars turns the cream into the dark ground of the footer, as below the hero of the home page. -->
    <div class="article__fence">
      <Scene scene={SCENES.fence} />
    </div>
  </main>
  <Footer />
  <script>
    import { initArticle } from "../../scripts/articles/index.ts";

    initArticle();
  </script>
</BaseLayout>

<style>
  .article {
    /* The side stays this far below the top of the screen, below the menu, and a link to a part stops there. */
    --article-top: calc(var(--space-menu-top) + var(--size-menu-bar) + var(--space-24));
  }

  .article__top {
    padding-top: calc(var(--space-menu-top) + var(--size-menu-bar) + var(--space-136));
    padding-bottom: var(--space-136);
  }

  .article__body {
    padding-bottom: var(--space-136);
  }

  /* As high as the band below the hero of the home page. */
  .article__fence {
    height: calc(3 * var(--cell));
  }

  .article__side,
  .article__main {
    grid-column: 1 / -1;
  }

  .article__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
  }

  /* The cover lies on the page like a panel of the home page, in the shape of the images of the posts on X. */
  .article__cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-paper);
    background: var(--color-dark);
    box-shadow: var(--shadow-paper);
  }

  .article__cover :global(.article__cover-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media not all and (min-width: 62rem) {
    .article__side {
      margin-bottom: var(--space-24);
    }
  }

  /*
   * The side stretches along the text, so that the list inside it can stay in view while the text scrolls. The text
   * reaches the last column, so that the room at the right matches the room at the left.
   */
  @media (min-width: 62rem) {
    .article__side {
      grid-column: 1 / 4;
    }

    .article__main {
      grid-column: 5 / -1;
    }
  }
</style>
